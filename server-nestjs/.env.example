MONGODB_URL=mongodb://127.0.0.1:27017/code-a2z-nestjs-dev
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Required. Use long, random, different values outside local development.
JWT_SECRET_ACCESS_KEY=replace-with-a-long-random-access-secret
JWT_SECRET_REFRESH_KEY=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# Optional. The owner of this organization receives admin_panel:access.
PLATFORM_ADMIN_ORG_ID=

# In-memory protection for login and password-change endpoints.
AUTH_RATE_LIMIT_POINTS=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
